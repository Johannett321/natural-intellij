# --- Proprietary third-party libraries ---------------------------------------
# Software AG NaturalONE client jars are required only for the optional NDV server
# module and must never be committed or redistributed. Place them here locally, or
# point Gradle at a NaturalONE installation with -PnaturalOneLibDir=...
# See README.md -> "Building with NDV server support".
libs/

# --- Local analysis artefacts -------------------------------------------------
# Protocol captures: these record live server sessions (hostnames, user IDs, payloads).
wiresharkdumps/
*.pcap
*.pcapng
