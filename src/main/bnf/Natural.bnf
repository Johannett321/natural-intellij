      KW_END_NOREC = "END-NOREC"
      KW_END_WORK = "END-WORK"
      KW_END            = "END"

      // DEFINE openers
      KW_DEFINE_DATA    = "DEFINE DATA"
      KW_DEFINE         = "DEFINE"
      KW_SUBROUTINE     = "SUBROUTINE"
      KW_DEFINE_FUNCTION = "DEFINE FUNCTION"
      KW_DEFINE_PRINTER = "DEFINE PRINTER"
      KW_DEFINE_WINDOW = "DEFINE WINDOW"
      KW_DEFINE_WORK_FILE = "DEFINE WORK FILE"
      KW_DEFINE_PROTOTYPE = "DEFINE PROTOTYPE"
      KW_DEFINE_CLASS = "DEFINE CLASS"

      // Control flow
      KW_IF = "IF"
      KW_THEN = "THEN"
      KW_ELSE = "ELSE"
      KW_FOR = "FOR"
      KW_REPEAT = "REPEAT"
      KW_WHILE = "WHILE"
