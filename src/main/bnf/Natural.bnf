{
    parserClass="com.appweb.natural.intellij.parser.NaturalParser"
    parserUtilClass="com.appweb.natural.intellij.parser.NaturalParserUtil"

    extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

    psiClassPrefix="Natural"
    psiImplClassSuffix="Impl"
    psiPackage="com.appweb.natural.intellij.psi"
    psiImplPackage="com.appweb.natural.intellij.psi.impl"

    elementTypeHolderClass="com.appweb.natural.intellij.psi.NaturalTypes"
    elementTypeClass="com.appweb.natural.intellij.psi.NaturalElementType"
    tokenTypeClass="com.appweb.natural.intellij.psi.NaturalTokenType"
    psiImplUtilClass="com.appweb.natural.intellij.psi.NaturalPsiImplUtil"

    tokens=[
      // Comments
      LINE_COMMENT      = "LINE_COMMENT"

      // Literals
      STRING_LITERAL = "STRING_LITERAL"
      NUMBER = "NUMBER"
      DATE_LITERAL = "DATE_LITERAL"
      TIME_LITERAL = "TIME_LITERAL"
      TIMESTAMP_LITERAL = "TIMESTAMP_LITERAL"
      HEX_LITERAL = "HEX_LITERAL"
      UNICODE_HEX_LITERAL = "UNICODE_HEX_LITERAL"

      // Identifiers
      USER_VARIABLE = "USER_VARIABLE"
      SYSTEM_VARIABLE = "SYSTEM_VARIABLE"
      IDENTIFIER = "IDENTIFIER"

      // Structural
      LEVEL_NUMBER = "LEVEL_NUMBER"
      DATA_TYPE_SPEC = "DATA_TYPE_SPEC"

      // Block terminators
      KW_END_IF = "END-IF"
      KW_END_FOR = "END-FOR"
      KW_END_REPEAT = "END-REPEAT"
      KW_END_DECIDE = "END-DECIDE"
      KW_END_DEFINE     = "END-DEFINE"
      KW_END_SUBROUTINE = "END-SUBROUTINE"
      KW_END_FUNCTION = "END-FUNCTION"
      KW_END_READ = "END-READ"
      KW_END_FIND = "END-FIND"
      KW_END_SORT = "END-SORT"
